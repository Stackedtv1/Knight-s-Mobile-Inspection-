+    else if (r.roadtest === 'Yes' && !r.drive) add('err', 'Road Test: Overall Drive Quality is not rated.');
+    else if (r.roadtest === 'Yes' && r.drive === 'NA') add('warn', 'Road Test: marked performed but Drive Quality is N/A.');
+    if (!r.verdict) add('err', "Inspector's Verdict is not selected.");
+    if (!r.summary.trim()) add('err', 'Summary for the customer is blank.');
