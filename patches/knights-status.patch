+
+  // Counts the rated fields inside a section: selects, radio groups, and tread-depth inputs
+  function secFieldStats(form, sec) {
+    const slot = document.querySelector(`.ss-slot[data-form="${form}"][data-sec="${sec}"]`);
+    const stats = { total:0, filled:0, na:0, results:0 };
+    if (!slot) return stats;
+    const box = slot.parentElement;
+    const isNA = v => v==='NA' || v==='N/A';
+    box.querySelectorAll('select').forEach(el => {
+      stats.total++;
+      if (el.value !== '') { stats.filled++; if (isNA(el.value)) stats.na++; else stats.results++; }
+    });
+    box.querySelectorAll('input[type="text"][id*="tread"]').forEach(el => {
+      stats.total++;
+      if (el.value.trim()) { stats.filled++; stats.results++; }
+    });
+    const radioNames = new Set(Array.from(box.querySelectorAll('input[type="radio"]')).map(r => r.name));
+    radioNames.forEach(name => {
+      stats.total++;
+      const c = box.querySelector(`input[type="radio"][name="${name}"]:checked`);
+      if (c) { stats.filled++; if (isNA(c.value)) stats.na++; else stats.results++; }
+    });
+    return stats;
+  }
+
+  function reviewSections(form) {
+    const issues = [];
+    Object.entries(SEC_DEFS[form]).forEach(([sec, title]) => {
+      const ss = _secStatus[form][sec] || {status:'', note:''};
+      const st = secFieldStats(form, sec);
+      const unrated = st.total - st.filled;
+      if (!ss.status) {
+        issues.push({level:'err', msg:`${title}: pick a section status (Inspected, Limited, or Not inspected).`});
+      } else if (ss.status === 'inspected') {
+        if (st.filled === 0) issues.push({level:'err', msg:`${title}: marked Inspected but nothing is rated.`});
+        else if (unrated > 0) issues.push({level:'err', msg:`${title}: ${unrated} item${unrated>1?'s':''} not rated — rate ${unrated>1?'them':'it'} or mark the section Limited.`});
+        if (st.na > 0) issues.push({level:'warn', msg:`${title}: ${st.na} item${st.na>1?'s':''} marked N/A. If you couldn't check ${st.na>1?'them':'it'}, mark the section Limited and say why.`});
+      } else {
+        if (!ss.note.trim()) issues.push({level:'err', msg:`${title}: marked ${SEC_STATUS_LABEL[ss.status]} — add the reason.`});
+        if (ss.status === 'not' && st.results > 0) issues.push({level:'err', msg:`${title}: marked Not inspected but ${st.results} item${st.results>1?'s have':' has'} a rating. Clear them or change the status.`});
+      }
+    });
+    return issues;
+  }
